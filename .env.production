# Committed on purpose. Every value here is PUBLIC by design:
#   - the project URL is in every request the browser makes
#   - the publishable key ships inside the JS bundle; RLS protects the data
# Nothing secret goes in this file — secrets stay in .env.local (gitignored)
# or in Supabase Edge Function secrets. Cloudflare's build has no env vars
# otherwise, and without these the app throws at startup in production.
VITE_SUPABASE_URL=https://smzwbqxttdyvohuizynl.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_OIuXLR4L_4L9nobkc1Vdfw_oGoee3Yt
# Cloudflare Turnstile's site key, public by design like the publishable key:
# it shows the bot check on the studio's sign-in and before a phone's first
# upload. Its secret lives only in Supabase's Auth settings.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFbtZb_Xw79jsru8
# Contributors' uploads, and the studio's Contributors map that reads them.
# On only once the contributions migration is live and Supabase allows
# anonymous sign-ins behind Turnstile (see supabase/apply/README.md).
VITE_CONTRIBUTIONS=1
# The studio's draft, submit and approve: a save is a draft until an editor
# approves it, and only approved rows reach the published map. Needs the
# reviewed_draft_approval migration live (supabase/apply/README.md).
VITE_STUDIO_DRAFTS=1
