<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark: tokens.css has no dark mode yet, so the words take Android's own notification text
  colours on its dark shade; the mode's dot keeps its colours. Replace these with the tokens' dark
  values once tokens.css has them.
-->
<resources>
    <color name="ride_content_primary">@android:color/primary_text_dark</color>
    <color name="ride_content_quaternary">@android:color/secondary_text_dark</color>
    <color name="ride_content_disabled">@android:color/tertiary_text_dark</color>
    <color name="ride_paused_ring">#525252</color>
    <color name="ride_paused_dot">@android:color/primary_text_dark</color>
</resources>
