// How Cloudflare serves the built site (dist/), for every branch.
//
// Without a config, Workers Builds works these settings out for itself when
// it deploys main, but a branch's build fails. Written down here, main deploys
// and every branch gets a Preview of its own at
// <branch>-para.<account>.workers.dev; the `staging` branch's is the owner's
// staging site.
//
// The settings, as production works them out for itself:
//   - an address with no file answers with the map's page, 200
//     (single-page-application), which is also how /.vite/ and
//     /.assetsignore stay unserved;
//   - /index.html and /studio redirect to / and /studio/ (html_handling's
//     default, auto-trailing-slash).
{
  "name": "para",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "workers_dev": true,
  "preview_urls": true,
  // Branch builds run `wrangler preview`, which refuses to run without this
  // block. Empty: a Preview uses the same settings as production.
  "previews": {},
}
