// How Cloudflare serves the built site (dist/), for every branch.
//
// Deployed from GitHub Actions (.github/workflows/deploy.yml): main deploys,
// and staging and every pull request get a Preview of their own at
// <branch>-para.<account>.workers.dev; the `staging` branch's is the owner's
// staging site.
//
// The settings, as production works them out for itself:
//   - an address with no file answers with the map's page, 200
//     (single-page-application), which is also how /.vite/ and
//     /.assetsignore stay unserved;
//   - /index.html and /studio redirect to / and /studio/ (html_handling's
//     default, auto-trailing-slash).
//
// The script (workers/site/src/index.ts) runs first for /api/*, where it
// answers a commuter's route report at /api/report (ADR 0010), and for every
// page address, where on the production site it answers with Coming soon in
// the map's place (coming-soon.ts). The built folders below that hold no page
// of the map's (the hashed bundles, the published map's data, icons, the
// editor, the contributor page, Coming soon itself and /app/'s fonts) are
// served from dist/ as above, without the script. The report's two secrets,
// REPORT_DATABASE_URL and TURNSTILE_SECRET_KEY, are set by the owner in the
// dashboard (Workers & Pages → para → Settings → Variables and Secrets), never
// here.
{
  "name": "para",
  "main": "workers/site/src/index.ts",
  "compatibility_date": "2026-09-01",
  // The postgres driver the report uses needs Node's streams and sockets.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/data/*",
      "!/icons/*",
      "!/studio/*",
      "!/contribute/*",
      "!/coming-soon/*",
      "!/app/fonts/*",
    ],
  },
  // Five reports a minute from one sender. The limiter is keyed by the
  // sender's address in Cloudflare's memory; the address is never stored or
  // logged (ADR 0010).
  "ratelimits": [
    {
      "name": "REPORT_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "workers_dev": true,
  "preview_urls": true,
  // Branch Previews (`wrangler preview` in .github/workflows/deploy.yml)
  // refuse to run without this block. Empty: a Preview uses the same
  // settings as production.
  "previews": {},
}
