# The Android app's build (`vite build --mode apk`, vite.apk.config.ts). Every value here is
# PUBLIC by design, like .env.production's: the app ships them inside its files.
VITE_SUPABASE_URL=https://smzwbqxttdyvohuizynl.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_OIuXLR4L_4L9nobkc1Vdfw_oGoee3Yt
