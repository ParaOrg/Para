# The Android app's build (`vite build --mode apk`, vite.apk.config.ts). Every value is public.
# Uploads are OFF and the project's address is left out on purpose: this build cannot send a
# recording anywhere, so a test app can never write to the live database.
VITE_CONTRIBUTIONS=0
# The bot check's public site key, for the spike's check of whether Turnstile renders inside the
# app (src/features/contribute/native-turnstile-check.tsx). Nothing is verified with it.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFbtZb_Xw79jsru8
